const MOD_ICON={'영업관리':'▣','설계관리':'✎','구매관리':'▤','조립관리':'⚙','원가관리':'◴','조직도':'⛶','SQ':'◈','기준정보':'▦','사용메뉴얼':'📖'};
const MOD_DESC={'영업관리':'수주 · 제작계획 · SET발주 · 경비','설계관리':'외주설계 · 사내설계 · PARTLIST','구매관리':'원재료 · 구매품 · 가공/외주가공','조립관리':'조립실적 · 검사실적','원가관리':'제조원가 · 매입/매출 · 재고','SQ':'품질목표 · 심사 · 부적합 · 4M · 계측기 · 문서/도면 · 추적성','기준정보':'공정 · 부품 · 자재 · 설비 · 업체 · 사용자 · 단가','사용메뉴얼':'시스템 사용 안내'};
const HOME={id:'home',title:'홈',file:null,home:true};

let activeModule='', activeId='', prevId='';
const openTabs=new Map();  /* id -> page */
const pinned=new Set(['home']);
let favs=JSON.parse(localStorage.getItem('ipmes.favs')||'[]');
const $=s=>document.querySelector(s);
const el=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e;};
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

/* ---------- 권한 ---------- */
function canView(path){if((path||'').includes('사용메뉴얼'))return true;const a=window.MES_AUTH;return !a||!a.session?true:a.can(path,'view')}
function visibleModules(){return MODULES.filter(m=>{if(m==='사용메뉴얼')return true;const a=window.MES_AUTH;if(!a||!a.session||a.role==='admin'||a.role==='master')return true;
  return Object.entries(APP[m]?.menus||{}).some(([sec,gs])=>gs.some(g=>g.items.some(n=>a.can(m+'/'+sec+'/'+n,'view'))))})}
function groupsOf(mod,sec){return (APP[mod]?.menus?.[sec]||[]).map(g=>({name:g.name,items:g.items.filter(n=>canView(mod+'/'+sec+'/'+n))})).filter(g=>g.items.length)}
/* 화면파일 → 메뉴경로 (iframe의 mes_db.js가 권한 판단에 사용) */
window.MES_MENU_OF=function(file){
  for(const [mod,cfg] of Object.entries(APP))
    for(const [sec,groups] of Object.entries(cfg.menus||{}))
      for(const g of groups)for(const n of g.items)
        if(pageRegistry[n]?.file===file)return mod+'/'+sec+'/'+n;
  return null;
};
/* 메뉴명 → {mod,sec,group} */
function locate(name){
  for(const mod of MODULES)for(const [sec,gs] of Object.entries(APP[mod]?.menus||{}))for(const g of gs)if(g.items.includes(name))return{mod,sec,group:g.name};
  return null;
}
function flatMenu(){const out=[];for(const mod of visibleModules())for(const sec of (APP[mod]?.secondary||[]))for(const g of groupsOf(mod,sec.name))for(const n of g.items)out.push({name:n,mod,sec:sec.name,group:g.name});return out}

/* ---------- 상단 모듈 메뉴 (메가) ---------- */
function buildTop(){
  const ul=$('#topMenu');ul.innerHTML='';
  visibleModules().forEach(mod=>{
    const li=el('li',mod===activeModule?'on':'');
    const b=el('button','',mod);b.onclick=()=>{const was=li.classList.contains('pin');if(was)setModule(mod);else pinModule(mod)};li.appendChild(b);
    const mega=el('div','mega');let any=false;
    (APP[mod]?.secondary||[]).forEach(sec=>{
      const gs=groupsOf(mod,sec.name);if(!gs.length)return;any=true;
      const col=el('div','col',`<h4>${sec.icon||''} ${esc(sec.name)}</h4>`);
      gs.forEach(g=>{if(gs.length>1||g.name!==sec.name)col.appendChild(el('h5','',esc(g.name)));
        g.items.forEach(n=>col.appendChild(menuLink(n)))});
      mega.appendChild(col);
    });
    if(any){li.appendChild(mega);li.onmouseenter=()=>placeMega(li,mega);li.onmouseleave=()=>li.classList.remove('pin')}
    ul.appendChild(li);
    if(mod==='원가관리'){const o=el('li',activeId==='org_chart'?'on':'');const ob=el('button','','조직도');ob.onclick=()=>openByName('조직도');o.appendChild(ob);ul.appendChild(o)}
  });
}

/* 메가메뉴가 화면 오른쪽을 넘지 않게 위치 보정 */
function placeMega(li,mega){
  if(!mega)return;mega.style.left='0px';mega.style.display='flex';
  const r=mega.getBoundingClientRect(),vw=window.innerWidth-12;
  if(r.right>vw)mega.style.left=(vw-r.right)+'px';
  const lr=li.getBoundingClientRect();if(lr.left+parseFloat(mega.style.left)<12)mega.style.left=(12-lr.left)+'px';
  mega.style.display='';
}
/* ---------- 메뉴 링크 ---------- */
function buildSide(){}
function menuLink(n){
  const p=pageRegistry[n];const on=p&&p.id===activeId;
  const a=el('a',on?'active':'',`<span>${esc(n)}</span><span class="star ${favs.includes(n)?'on':''}" title="즐겨찾기">★</span>`);
  a.href='#';a.dataset.name=n;a.onclick=e=>{e.preventDefault();openByName(n);document.querySelectorAll('.top-menu>li.pin').forEach(x=>x.classList.remove('pin'))};
  a.querySelector('.star').onclick=e=>{e.stopPropagation();e.preventDefault();toggleFav(n)};
  a.onmouseover=()=>{if(p&&p.file)prefetch(p.file+(p.file.includes('?')?'&':'?')+'v='+APP_VER)};
  return a;
}
function setModule(m){activeModule=m;buildTop();statusMsg.textContent=`${m} 메뉴를 선택했습니다.`}
function pinModule(m){setModule(m);const li=[...document.querySelectorAll('#topMenu>li')].find(x=>x.querySelector('button').textContent===m);if(li){li.classList.add('pin');placeMega(li,li.querySelector('.mega'))}}

/* ---------- 즐겨찾기 ---------- */
function toggleFav(n){
  favs=favs.includes(n)?favs.filter(x=>x!==n):[...favs,n];localStorage.setItem('ipmes.favs',JSON.stringify(favs));
  document.querySelectorAll(`.mega a[data-name="${n}"] .star`).forEach(s=>s.classList.toggle('on',favs.includes(n)));
  renderFav();const h=document.getElementById('view_home');if(h)h.innerHTML=homeHTML();
}
function renderFav(){
  const m=$('#favMenu');m.innerHTML='<div class="hd">즐겨찾기</div>'+(favs.length?'':'<div class="hd">상단 메뉴 항목의 ★ 를 눌러 추가</div>');
  favs.forEach(n=>{const loc=locate(n);const b=el('button','',`<span>${esc(n)}</span><small style="margin-left:auto;color:var(--ink-3)">${loc?esc(loc.mod+' › '+loc.sec):''}</small>`);b.onclick=()=>{openByName(n);closeDd()};m.appendChild(b)});
}

/* ---------- 페이지 열기 ---------- */
function slugify(name){return 'pending_'+Math.abs([...name].reduce((a,c)=>((a<<5)-a+c.charCodeAt(0))|0,0))}
function openByName(name){
  let p=pageRegistry[name];if(!p){p={id:slugify(name),title:name,file:null};pageRegistry[name]=p}
  const loc=locate(name);if(loc){p.menu=name;p.mod=loc.mod;p.sec=loc.sec;if(loc.mod!==activeModule){activeModule=loc.mod;buildTop()}}
  openPage(p);
}
function openPage(p){if(!openTabs.has(p.id))openTabs.set(p.id,p);if(activeId!==p.id)prevId=activeId;activeId=p.id;renderTabs();renderStage();buildTop();renderCrumb();
  statusMsg.textContent=p.home?'홈':p.file?`${p.title} 화면을 열었습니다.`:`${p.title} 화면은 준비 중입니다.`}
function activate(id){if(activeId!==id)prevId=activeId;activeId=id;const p=openTabs.get(id);if(p&&p.mod)activeModule=p.mod;buildTop();renderTabs();renderStage();renderCrumb()}
function renderCrumb(){
  const p=openTabs.get(activeId);const c=$('#crumb');
  if(!p){c.innerHTML='<span>IPTK MES</span>';return}
  c.innerHTML=`<span>IPTK MES</span>${p.mod?`<span>›</span><span>${esc(p.mod)}</span><span>›</span><span>${esc(p.sec)}</span>`:''}<span>›</span><b>${esc(p.title)}</b><span class="right"><span>${p.file?esc(p.file):''}</span></span>`;
}

/* ---------- 탭 ---------- */
function renderTabs(){
  const bar=$('#tabs');bar.innerHTML='';
  openTabs.forEach(p=>{
    const pin=pinned.has(p.id);
    const d=el('div','tab'+(p.id===activeId?' active':''),`<span>${pin?'📌 ':''}${esc(p.title)}</span>${pin?'':'<span class="x" title="닫기">×</span>'}`);
    d.onclick=()=>activate(p.id);d.onauxclick=e=>{if(e.button===1)closeTab(p.id)};
    d.oncontextmenu=e=>{e.preventDefault();showCtx(e,p.id)};
    const x=d.querySelector('.x');if(x)x.onclick=e=>{e.stopPropagation();closeTab(p.id)};
    bar.appendChild(d);if(p.id===activeId)requestAnimationFrame(()=>d.scrollIntoView&&d.scrollIntoView({inline:'nearest',block:'nearest'}));
  });
}
function closeTab(id,e){e?.stopPropagation();if(pinned.has(id))return;
  const ids=[...openTabs.keys()],idx=ids.indexOf(id);if(idx<0)return;
  openTabs.delete(id);VREADY.delete(id);document.getElementById('view_'+id)?.remove();
  if(activeId===id){activeId=ids[idx+1]||ids[idx-1]||'';if(!openTabs.has(activeId))activeId=[...openTabs.keys()][0]||''}
  renderTabs();renderStage();buildTop();renderCrumb()}
const ctx=$('#tabCtx');let ctxTab=null;
function showCtx(e,id){ctxTab=id;ctx.style.left=e.clientX+'px';ctx.style.top=e.clientY+'px';ctx.classList.add('open')}
ctx.querySelectorAll('button').forEach(b=>b.onclick=()=>{
  const ids=[...openTabs.keys()],i=ids.indexOf(ctxTab),p=openTabs.get(ctxTab);ctx.classList.remove('open');if(!p)return;
  switch(b.dataset.act){
    case'refresh':{const v=document.getElementById('view_'+p.id);if(v&&v.tagName==='IFRAME'){VREADY.delete(p.id);v.contentWindow.location.reload()}else if(v&&p.home)v.innerHTML=homeHTML();break}
    case'pin':if(p.id!=='home'){pinned.has(p.id)?pinned.delete(p.id):pinned.add(p.id)}renderTabs();break;
    case'others':ids.forEach(x=>{if(x!==p.id)closeTab(x)});break;
    case'right':ids.slice(i+1).forEach(x=>closeTab(x));break;
    case'close':closeTab(p.id);break;
  }
});
$('#tabCloseAll').onclick=()=>[...openTabs.keys()].forEach(x=>closeTab(x));
$('#tabPrev').onclick=()=>{const ids=[...openTabs.keys()],i=ids.indexOf(activeId);if(i>0)activate(ids[i-1])};
$('#tabNext').onclick=()=>{const ids=[...openTabs.keys()],i=ids.indexOf(activeId);if(i<ids.length-1)activate(ids[i+1])};

/* ---------- 스테이지 (iframe) ---------- */
function injectCtx(f){
 try{
  const doc=f.contentDocument;
  if(!doc||!doc.body)return;
  if(doc.__mesCtxInjected||doc.querySelector('script[src*="mes_ctx.js"]'))return;
  doc.__mesCtxInjected=1;
  const s=doc.createElement('script');s.src='mes_ctx.js?v='+APP_VER;doc.body.appendChild(s);
 }catch(e){}
}
const VREADY=new Set();let vwaitTimer=null,pendingId=null;
function badgeOff(){try{return localStorage.getItem('mes_badge')==='off'}catch(e){return false}}
function viewReady(f){
  if(!f||f.tagName!=='IFRAME')return true;
  try{
    const d=f.contentDocument,w=f.contentWindow;
    if(!d||d.readyState!=='complete')return false;
    if(d.documentElement.classList.contains('mesdb-loading'))return false;
    if(w.__mesdbBound&&!badgeOff()&&!d.getElementById('mesdb-badge')&&!(w.MESDB&&w.MESDB.syncMaster))return false;
    return true;
  }catch(e){return true}
}
function makeView(p){
  if(document.getElementById('view_'+p.id))return;
  if(p.home){const d=el('div','placeholder',homeHTML());d.id='view_home';stage.appendChild(d);return}
  if(p.file){
    const f=document.createElement('iframe');f.id='view_'+p.id;
    f.src=p.file+(p.file.includes('?')?'&':'?')+'v='+APP_VER;
    f.addEventListener('load',()=>injectCtx(f));
    stage.appendChild(f);
  }else{
    const d=el('div','placeholder',`<div class="ph"><h1>${esc(p.title)}</h1><p>${esc(p.mod||'')} ${p.sec?'› '+esc(p.sec):''}</p><div class="card" style="max-width:520px">이 화면은 아직 만들어지지 않았습니다.<br><br><code>${esc(p.id)}.html</code> 파일을 만들면 이 자리에 표시됩니다.</div></div>`);
    d.id='view_'+p.id;stage.appendChild(d);
  }
}
function swapTo(id){
  clearTimeout(vwaitTimer);pendingId=null;VREADY.add(id);vwait.classList.remove('on');
  stage.querySelectorAll('iframe,.placeholder').forEach(x=>x.classList.toggle('on',x.id==='view_'+id));
}
function renderStage(){
  for(const p of openTabs.values())makeView(p);
  const v=document.getElementById('view_'+activeId);
  if(!v){vwait.classList.remove('on');stage.querySelectorAll('iframe,.placeholder').forEach(x=>x.classList.remove('on'));return}
  if(VREADY.has(activeId)||viewReady(v)){swapTo(activeId);return}
  pendingId=activeId;vwait.classList.add('on');const t0=Date.now();clearTimeout(vwaitTimer);
  (function poll(){if(pendingId!==activeId)return;const f=document.getElementById('view_'+activeId);
    if(!f||viewReady(f)||Date.now()-t0>3000){swapTo(activeId);return}vwaitTimer=setTimeout(poll,60)})();
}

/* ---------- 홈 ---------- */
function homeHTML(){
  const mods=visibleModules().filter(m=>m!=='사용메뉴얼');
  const quick=['수주등록','수주현황','현황판','제작계획등록','설계계획등록','가공계획등록','구매품 발주','조립실적등록'];
  return `<div class="home">
  <div class="card" style="grid-column:span 8"><h3>업무 모듈 <span>상단 메뉴에 마우스를 올리면 세부 메뉴가 열립니다</span></h3>
   <div class="modcard">${mods.map(m=>`<button onclick="pinModule('${m}')"><b>${MOD_ICON[m]||'▪'} ${esc(m)}</b><small>${esc(MOD_DESC[m]||'')}</small></button>`).join('')}</div></div>
  <div class="card" style="grid-column:span 4"><h3>즐겨찾기 <span>★ ${favs.length}</span></h3>
   <div class="favlist">${favs.length?favs.map(n=>{const l=locate(n);return `<button onclick="openByName('${esc(n)}')"><span>${esc(n)}</span><small>${l?esc(l.mod):''}</small></button>`}).join(''):'<small style="color:var(--ink-3)">상단 메뉴 항목의 ★ 를 눌러 추가</small>'}</div></div>
  <div class="card" style="grid-column:span 8"><h3>바로가기</h3>
   <div class="quick">${quick.filter(n=>{const l=locate(n);return l&&canView(l.mod+'/'+l.sec+'/'+n)}).map(n=>`<button onclick="openByName('${esc(n)}')"><span style="font-size:18px">${MOD_ICON[locate(n).mod]}</span>${esc(n)}</button>`).join('')}</div></div>
  <div class="card" style="grid-column:span 4"><h3>안내</h3>
   <div style="color:var(--ink-2);line-height:1.7">· <b>Ctrl+K</b> 메뉴 검색<br>· 좌측 상단 <b>⌂ 홈</b> 클릭: 이 홈 화면으로 이동<br>· 상단 메뉴(영업관리 등)에 마우스를 올리면 세부 메뉴가 펼쳐지고, <b>클릭</b>하면 마우스를 떼도 펼쳐진 채로 고정됩니다 (다시 클릭하면 해제)<br>· 열린 화면은 상단에 <b>탭</b>으로 쌓입니다. 탭을 <b>마우스 오른쪽 클릭</b>하면 고정(실수로 닫히지 않게) · 새로고침 · 닫기 메뉴가 나옵니다<br>· 탭을 <b>마우스 휠 버튼</b>으로 누르면 바로 닫힙니다<br>· <button onclick="openByName('사용메뉴얼')" style="color:var(--blue)">사용메뉴얼 열기</button><br>· <button onclick="openByName('수정요청게시판')" style="color:var(--blue)">수정요청게시판 열기</button></div></div>
  </div>`;
}

/* ---------- 메뉴 검색 ---------- */
const sIn=$('#menuSearch'),sRes=$('#searchRes');let sel=0;
sIn.oninput=()=>{
  const q=sIn.value.trim().toLowerCase();if(!q){sRes.classList.remove('open');return}
  const hits=flatMenu().filter(m=>m.name.toLowerCase().includes(q)||m.sec.toLowerCase().includes(q)||m.mod.toLowerCase().includes(q)).slice(0,14);sel=0;
  sRes.innerHTML=hits.length?hits.map((m,i)=>`<button data-name="${esc(m.name)}" class="${i===0?'sel':''}"><span>${esc(m.name)}</span><small>${esc(m.mod+' › '+m.sec)}</small></button>`).join(''):'<button disabled><small>검색 결과 없음</small></button>';
  sRes.querySelectorAll('button[data-name]').forEach(b=>b.onclick=()=>pick(b.dataset.name));sRes.classList.add('open');
};
function pick(n){openByName(n);sIn.value='';sRes.classList.remove('open');sIn.blur()}
sIn.onkeydown=e=>{
  const items=[...sRes.querySelectorAll('button[data-name]')];if(!items.length)return;
  if(e.key==='ArrowDown')sel=(sel+1)%items.length;else if(e.key==='ArrowUp')sel=(sel-1+items.length)%items.length;
  else if(e.key==='Enter'){pick(items[sel].dataset.name);return}else if(e.key==='Escape'){sRes.classList.remove('open');sIn.blur();return}else return;
  e.preventDefault();items.forEach((b,i)=>b.classList.toggle('sel',i===sel));
};
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();sIn.focus();sIn.select()}
  if(e.key==='Escape'){closeDd();ctx.classList.remove('open');document.querySelectorAll('.top-menu>li.pin').forEach(x=>x.classList.remove('pin'))}
});

/* ---------- 드롭다운 ---------- */
function closeDd(){document.querySelectorAll('.dd.open').forEach(d=>d.classList.remove('open'))}
document.querySelectorAll('.dd>button').forEach(b=>b.onclick=e=>{e.stopPropagation();const d=b.parentElement;const was=d.classList.contains('open');closeDd();if(!was)d.classList.add('open')});
document.addEventListener('click',e=>{
  if(!e.target.closest('.dd'))closeDd();if(!e.target.closest('.ctx'))ctx.classList.remove('open');if(!e.target.closest('.search'))sRes.classList.remove('open');if(e.target.isConnected&&!e.target.closest('.top-menu'))document.querySelectorAll('.top-menu>li.pin').forEach(x=>x.classList.remove('pin'));
});
$('#brand').onclick=()=>openPage(HOME);
$('#btnReq').onclick=()=>openByName('수정요청게시판');
/* 화면(iframe)에서 참조: 메뉴구조 · 현재 탭 */
window.IPMES={APP,pageRegistry,get active(){return openTabs.get(activeId)||null},get prev(){return openTabs.get(prevId)||null}};

/* ---------- 사용자 (mes_auth.js 연동) ---------- */
function syncUser(){
  const a=window.MES_AUTH;const name=a?.name||'게스트';const role=a?.role==='master'?'마스터':a?.role==='admin'?'관리자':a?.session?'사용자':'미로그인';
  $('#uName').textContent=name;$('#uRole').textContent=role;$('#uAv').textContent=String(name)[0].toUpperCase();$('#uHd').textContent=a?.session?.user?.email||'IPTK MES';
}
$('#btnPw').onclick=()=>{closeDd();document.getElementById('pwchg')?.click()};
$('#btnLogout').onclick=()=>{closeDd();const b=document.getElementById('lgout');if(b)b.click();else{try{localStorage.removeItem('ipmes.session')}catch(e){}location.reload()}};

/* ---------- 선반입 ---------- */
const _pf=new Set();
function prefetch(url){if(!url||_pf.has(url))return;_pf.add(url);
  try{const l=document.createElement('link');l.rel='prefetch';l.href=url;l.as='document';document.head.appendChild(l)}catch(e){}
  try{fetch(url,{cache:'force-cache'}).catch(()=>{})}catch(e){}}
(window.requestIdleCallback||(f=>setTimeout(f,1200)))(()=>{
  ['mes_db.js?v='+APP_VER,'mes_ctx.js?v='+APP_VER,'mes_lookup.js?v='+APP_VER,'mes_paste.js?v='+APP_VER,'mes_auth.js?v='+APP_VER].forEach(prefetch);
  let i=0;const hot=['sale_order_status.html','purchase_order_input.html','purchase_order_status.html','material_order_input.html','outsourcing_order_input.html','vendor_management.html','status_board.html'];
  const step=()=>{if(i>=hot.length)return;prefetch(hot[i++]+'?v='+APP_VER);setTimeout(step,600)};step()});

function tick(){now.textContent=new Date().toLocaleString('ko-KR',{dateStyle:'medium',timeStyle:'medium'})}
verTxt.textContent='APP v'+APP_VER;
buildTop();renderFav();syncUser();openPage(HOME);tick();setInterval(tick,1000);
</script>
<script>document.write('<script src="mes_auth.js?v='+APP_VER+'"><\/script>')</script>
<script>window.addEventListener("mes-auth-ready",()=>{try{VREADY.clear();buildTop();renderFav();syncUser();const h=document.getElementById('view_home');if(h)h.innerHTML=homeHTML();renderStage()}catch(e){}});</script>
</body>
</html>
