<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>IPTK MES</title>
<link rel="preconnect" href="https://jgvikmakenpllwxwdugk.supabase.co" crossorigin>
<link rel="dns-prefetch" href="https://jgvikmakenpllwxwdugk.supabase.co">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
:root{
  --side-w:260px; --side-min:56px; --top-h:48px; --tab-h:40px;
  --ink:#1c2430; --ink-2:#4a5568; --ink-3:#8a94a6;
  --steel:#1f2733; --steel-2:#28323f; --steel-3:#343f50;
  --paper:#f1f3f6; --white:#fff; --line:#dfe3ea; --line-2:#303b4c;
  --amber:#f2a93b; --green:#2fb27c; --red:#e05a4a; --blue:#3b82f6; --gray:#9aa4b5;
  --r:6px; --shadow:0 8px 24px rgba(20,28,40,.18);
  font-size:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:Pretendard,-apple-system,"Malgun Gothic","맑은 고딕",sans-serif;color:var(--ink);background:var(--paper);overflow:hidden}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,select{font:inherit}
::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-thumb{background:#c2c9d4;border-radius:4px}

.app{display:grid;grid-template-columns:1fr;grid-template-rows:var(--top-h) 1fr;height:100vh}
.top{grid-column:1/-1;display:flex;align-items:center;background:var(--steel);color:#dfe5ee;padding:0 12px 0 0;border-bottom:1px solid var(--line-2);position:relative;z-index:50}
.main{display:flex;flex-direction:column;min-width:0;min-height:0}

/* top */
.brand{height:100%;display:flex;align-items:center;gap:10px;padding:0 16px 0 14px;flex-shrink:0;cursor:pointer;border-right:1px solid var(--line-2)}
.brand .mark{width:28px;height:28px;flex-shrink:0;display:grid;place-items:center;background:var(--amber);color:var(--steel);font-weight:800;border-radius:6px}
.brand .name{font-weight:700;letter-spacing:.3px;white-space:nowrap;color:#fff;display:flex;align-items:center;gap:8px}
.brand .name .home-lbl{font-size:14px;color:#fff}
.brand:hover .name .home-lbl{color:var(--amber)}
.brand .name small{font-weight:400;color:#8f9bb0}

.top-menu{display:flex;gap:2px;margin-left:8px;height:100%}
.top-menu>li{position:relative;list-style:none;height:100%;display:flex}
.top-menu>li>button{padding:0 16px;height:100%;color:#c7cfdb;font-weight:600;font-size:15px;border-bottom:2px solid transparent;white-space:nowrap}
.top-menu>li:hover>button{color:#fff;border-bottom-color:var(--amber)}
.top-menu>li.on>button{color:#fff;border-bottom-color:var(--amber)}
.top-menu>li.pin>button{color:#fff;border-bottom-color:var(--amber);background:var(--steel-2)}
.top-menu>li.pin .mega{display:flex}
.mega{position:absolute;top:100%;left:0;display:none;background:var(--white);color:var(--ink);border:1px solid var(--line);border-radius:0 0 var(--r) var(--r);box-shadow:var(--shadow);padding:14px 4px;z-index:60;flex-wrap:wrap;width:max-content;max-width:calc(100vw - 24px);max-height:calc(100vh - var(--top-h) - 12px);overflow-y:auto;overscroll-behavior:contain}
.top-menu>li:hover .mega{display:flex}
.mega .col{padding:0 16px 8px;border-right:1px solid var(--line);min-width:150px;align-self:start}
.mega .col:last-child{border-right:0}
.mega h4{font-size:14px;color:var(--ink-3);font-weight:600;margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid var(--line);white-space:nowrap}
.mega h5{font-size:12.5px;color:var(--ink-3);font-weight:500;margin:8px 0 2px}
.mega h5:first-of-type{margin-top:0}
.mega a{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:14px;color:var(--ink);text-decoration:none;white-space:nowrap}
.mega a:hover{color:var(--blue)}
.mega a.active{color:var(--blue);font-weight:600}
.mega a .star{margin-left:auto;padding-left:14px;color:#c9d0da;opacity:0;font-size:12px}
.mega a:hover .star{opacity:1}
.mega a .star.on{opacity:1;color:var(--amber)}

.search{margin-left:auto;position:relative;width:280px}
.search input{width:100%;height:32px;background:var(--steel-2);border:1px solid var(--line-2);border-radius:var(--r);color:#fff;padding:0 32px 0 34px;outline:0}
.search input:focus{border-color:var(--amber)}
.search input::placeholder{color:#7f8aa0}
.search .ico{position:absolute;left:11px;top:9px;color:#7f8aa0}
.search kbd{position:absolute;right:8px;top:8px;font:11px Pretendard;color:#7f8aa0;border:1px solid #4a5568;border-radius:4px;padding:1px 5px}
.search-res{position:absolute;top:36px;left:0;right:0;background:var(--white);color:var(--ink);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);display:none;max-height:360px;overflow:auto;z-index:80}
.search-res.open{display:block}
.search-res button{display:flex;justify-content:space-between;width:100%;text-align:left;padding:9px 12px;font-size:14px}
.search-res button:hover,.search-res button.sel{background:#eef2f8}
.search-res small{color:var(--ink-3)}

.top-actions{display:flex;align-items:center;gap:4px;margin-left:12px}
.icon-btn{width:34px;height:34px;border-radius:var(--r);display:grid;place-items:center;color:#c7cfdb;position:relative}
.icon-btn:hover{background:var(--steel-3);color:#fff}
.icon-btn.txt{width:auto;padding:0 10px;display:flex;gap:6px;align-items:center;font-size:13px;color:var(--amber);border:1px solid var(--line-2)}
.icon-btn.txt:hover{color:#fff;border-color:var(--amber)}
@media (max-width:900px){.icon-btn.txt span{display:none}}
.ubtn{display:flex;align-items:center;gap:8px;padding:4px 8px 4px 4px;border-radius:var(--r);margin-left:6px}
.ubtn:hover{background:var(--steel-3)}
.avatar{width:26px;height:26px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px}
.ubtn .txt{text-align:left;line-height:1.15;white-space:nowrap}
.ubtn .txt b{display:block;color:#fff;font-weight:600}
.ubtn .txt span{font-size:11px;color:#8f9bb0}
.user{display:none} /* mes_auth.js 가 채우는 숨김 영역 */

.dd{position:relative}
.dd-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:200px;background:var(--white);color:var(--ink);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:6px;display:none;z-index:90}
.dd.open .dd-menu{display:block}
.dd-menu button,.dd-menu a{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:4px;text-align:left;text-decoration:none;color:var(--ink)}
.dd-menu button:hover,.dd-menu a:hover{background:#eef2f8}
.dd-menu hr{border:0;border-top:1px solid var(--line);margin:6px 0}
.dd-menu .hd{padding:6px 10px;font-size:11px;color:var(--ink-3)}

/* tabs */
.tabs{display:flex;align-items:flex-end;height:var(--tab-h);background:#e4e8ee;border-bottom:1px solid var(--line);padding:0 8px;gap:2px;overflow:hidden;flex-shrink:0}
.tabs-scroll{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0}
.tabs-scroll::-webkit-scrollbar{display:none}
.tab{display:flex;align-items:center;gap:8px;height:34px;padding:0 10px 0 12px;background:#d6dce5;border-radius:6px 6px 0 0;color:var(--ink-2);white-space:nowrap;cursor:pointer;border:1px solid transparent;border-bottom:0;font-size:14px;user-select:none}
.tab:hover{background:#e9edf3}
.tab.active{background:var(--white);color:var(--ink);border-color:var(--line);font-weight:600;position:relative}
.tab.active::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;background:var(--white)}
.tab .x{width:16px;height:16px;border-radius:4px;display:grid;place-items:center;color:var(--ink-3);font-size:14px;line-height:1}
.tab .x:hover{background:#c8cfda;color:var(--ink)}
.tabs-act{display:flex;gap:2px;padding-bottom:3px}
.tabs-act button{width:28px;height:28px;border-radius:4px;color:var(--ink-3);display:grid;place-items:center}
.tabs-act button:hover{background:#d6dce5;color:var(--ink)}
.ctx{position:fixed;display:none;background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:5px;min-width:170px;z-index:200}
.ctx.open{display:block}
.ctx button{display:block;width:100%;text-align:left;padding:7px 10px;border-radius:4px}
.ctx button:hover{background:#eef2f8}

/* content */
.crumb{display:flex;align-items:center;gap:6px;padding:8px 18px;color:var(--ink-3);font-size:13px;background:var(--white);border-bottom:1px solid var(--line)}
.crumb b{color:var(--ink);font-weight:600}
.crumb .right{margin-left:auto;display:flex;gap:14px;font-family:ui-monospace,Consolas,monospace;font-size:11px}
.stage{flex:1;min-height:0;position:relative;background:var(--white)}
.stage iframe{display:none;width:100%;height:100%;border:0;background:var(--white)}
.stage iframe.on{display:block}
.stage .vwait{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(255,255,255,.72);color:var(--ink-2);font-size:13px;z-index:5}
.stage .vwait.on{display:flex}
.placeholder{display:none;height:100%;padding:26px 28px}
.placeholder.on{display:block}
.ph h1{font-size:20px;font-weight:700;margin-bottom:4px}
.ph p{color:var(--ink-3);margin-bottom:22px}
.ph code{background:#e9edf3;padding:2px 6px;border-radius:4px;font-family:ui-monospace,Consolas,monospace;font-size:12px}
.card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px}

/* home */
.home{padding:18px 22px;display:grid;gap:14px;grid-template-columns:repeat(12,1fr);height:100%;overflow:auto;align-content:start}
.home .card h3{font-size:14px;font-weight:600;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}
.home .card h3 span{font-size:12px;color:var(--ink-3);font-weight:400}
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.quick button{border:1px solid var(--line);border-radius:var(--r);padding:12px 8px;display:grid;gap:6px;justify-items:center;font-size:12px;color:var(--ink-2);text-align:center}
.quick button:hover{border-color:var(--blue);color:var(--blue);background:#f4f8ff}
.modcard{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.modcard button{border:1px solid var(--line);border-radius:var(--r);padding:14px 12px;text-align:left;display:grid;gap:4px}
.modcard button b{font-size:14px}
.modcard button small{color:var(--ink-3);font-size:11px;line-height:1.4;white-space:normal}
.modcard button:hover{border-color:var(--blue);background:#f4f8ff}
.favlist{display:grid;gap:4px}
.favlist button{display:flex;justify-content:space-between;padding:7px 10px;border-radius:4px;border:1px solid var(--line)}
.favlist button:hover{border-color:var(--blue);color:var(--blue)}
.favlist small{color:var(--ink-3)}

.status{height:24px;background:var(--steel);color:#8f9bb0;font-size:11px;display:flex;align-items:center;gap:18px;padding:0 14px;flex-shrink:0}
.status .dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block;margin-right:5px}
.status .r{margin-left:auto}

@media (max-width:1100px){.modcard{grid-template-columns:repeat(2,1fr)}.home>.card{grid-column:span 12!important}}
@media (max-width:900px){.top-menu,.ubtn .txt{display:none}.search{width:170px}}
</style>
</head>
<body>

<div class="app" id="app">
  <header class="top">
    <div class="brand" id="brand" title="홈">
      <div class="mark">I</div>
      <div class="name"><span class="home-lbl">⌂ 홈</span><small>IPTK MES</small></div>
    </div>

    <ul class="top-menu" id="topMenu"></ul>

    <div class="search">
      <span class="ico">⌕</span>
      <input id="menuSearch" placeholder="메뉴 검색" autocomplete="off">
      <kbd>Ctrl K</kbd>
      <div class="search-res" id="searchRes"></div>
    </div>

    <div class="top-actions">
      <button class="icon-btn txt" id="btnReq" title="수정요청게시판">✎<span>수정요청</span></button>
      <div class="dd" id="ddFav">
        <button class="icon-btn" title="즐겨찾기">★</button>
        <div class="dd-menu" id="favMenu"></div>
      </div>
      <div class="dd" id="ddUser">
        <button class="ubtn">
          <span class="avatar" id="uAv">?</span>
          <span class="txt"><b id="uName">-</b><span id="uRole">-</span></span>
        </button>
        <div class="dd-menu">
          <div class="hd" id="uHd">IPTK MES</div>
          <button id="btnPw">비밀번호 변경</button>
          <hr>
          <button id="btnLogout">로그아웃</button>
        </div>
      </div>
      <div class="user"></div>
    </div>
  </header>

  <section class="main">
    <div class="tabs">
      <div class="tabs-scroll" id="tabs"></div>
      <div class="tabs-act">
        <button id="tabPrev" title="이전 탭">‹</button>
        <button id="tabNext" title="다음 탭">›</button>
        <button id="tabCloseAll" title="모두 닫기">×</button>
      </div>
    </div>
    <div class="ctx" id="tabCtx">
      <button data-act="refresh">새로고침</button>
      <button data-act="pin">고정 / 해제</button>
      <button data-act="others">다른 탭 닫기</button>
      <button data-act="right">오른쪽 탭 닫기</button>
      <button data-act="close">닫기</button>
    </div>
    <div class="crumb" id="crumb"><span>IPTK MES</span></div>
    <div class="stage" id="stage"><div class="vwait" id="vwait">화면을 여는 중…</div></div>
    <div class="status">
      <span><span class="dot"></span><span id="statusMsg">준비</span></span>
      <span id="verTxt"></span>
      <span class="r" id="now"></span>
    </div>
  </section>
</div>

<script>
const APP_VER='67';
const APP={
  '영업관리':{
    secondary:[
      {name:'수주',icon:'▣'},
      {name:'제작계획',icon:'◴'},
      {name:'SET발주',icon:'◆'},
      {name:'경비',icon:'▤'}
    ],
    menus:{
      '수주':[{name:'수주',items:['수주등록','수주현황','현황판']}],
      '제작계획':[{name:'제작계획',items:['제작계획등록','제작계획현황']}],
      'SET발주':[{name:'SET발주',items:['SET외주제작등록','SET발주입고','SET발주현황']}],
      '경비':[{name:'경비',items:['경비등록','경비현황']}]
    }
  },
  '설계관리':{
    secondary:[
      {name:'외주설계발주',icon:'✎'},
      {name:'사내설계',icon:'▤'},
      {name:'PARTLIST',icon:'▦'}
    ],
    menus:{
      '외주설계발주':[{name:'외주설계발주',items:['외주설계발주등록','외주설계발주입고','외주설계발주현황']}],
      '사내설계':[{name:'사내설계',items:['설계계획등록','설계실적등록','설계실적현황','설계실적조회']}],
      'PARTLIST':[{name:'PARTLIST',items:['PartList 등록(원재료)','PartList 등록(구매품)','PartList 현황','PartList 복사']}]
    }
  },
  '구매관리':{
    secondary:[
      {name:'원재료',icon:'▣'},
      {name:'구매품',icon:'◆'},
      {name:'가공',icon:'⚒'}
    ],
    menus:{
      '원재료':[
        {name:'원재료',items:['원재료 발주','원재료 입고','원재료 입고확정']},
        {name:'현황',items:['원재료 발주현황']}
      ],
      '구매품':[
        {name:'구매품',items:['구매품 발주','구매품 입고','구매품 입고확정']},
        {name:'현황',items:['구매품 발주현황']}
      ],
      '가공':[
        {name:'가공',items:['가공계획등록','공정이력카드']},
        {name:'외주가공',items:['외주가공 발주','외주가공 입고','외주가공 입고확정']},
        {name:'현황',items:['외주가공발주현황','가공구매 진척현황']}
      ]
    }
  },
  '조립관리':{
    secondary:[
      {name:'조립',icon:'⚙'},
      {name:'검사',icon:'⌕'}
    ],
    menus:{
      '조립':[{name:'조립',items:['조립실적등록','조립실적현황','조립실적조회']}],
      '검사':[{name:'검사',items:['검사실적등록']}]
    }
  },
  '원가관리':{
    secondary:[
      {name:'원가관리',icon:'◴'},
      {name:'매입매출현황',icon:'▥'}
    ],
    menus:{
      '원가관리':[{name:'제조원가',items:['제조원가조회(실시간)']}],
      '매입매출현황':[{name:'매입매출현황',items:['매입현황','매출현황','재고조회']}]
    }
  },
  'SQ':{
    secondary:[
      {name:'알림판',icon:'🔔'},
      {name:'품질목표',icon:'◎'},
      {name:'심사',icon:'☑'},
      {name:'부적합',icon:'⚠'},
      {name:'변경관리',icon:'⇄'},
      {name:'계측기',icon:'⌗'},
      {name:'문서/도면',icon:'▤'},
      {name:'추적성',icon:'⌕'},
      {name:'관리계획서',icon:'⊞'},
      {name:'교육/자격',icon:'⚇'},
      {name:'협력업체',icon:'⚑'}
    ],
    menus:{
      '알림판':[{name:'점검',items:['기한관리 알림판','입력누락 점검판']}],
      '품질목표':[{name:'품질목표',items:['품질목표 등록','품질목표 달성현황','품질목표 월별추이']}],
      '심사':[
        {name:'심사',items:['심사등록','지적사항등록','심사현황','지적사항 조치현황']},
        {name:'고객 요구사항',items:['고객 요구사항 등록','고객 요구사항 현황']}
      ],
      '부적합':[{name:'부적합',items:['부적합등록','시정조치등록','부적합현황']}],
      '변경관리':[{name:'4M변경',items:['4M변경신청','4M변경현황']}],
      '계측기':[{name:'계측기',items:['계측기대장','교정이력등록','계측기 교정현황']}],
      '문서/도면':[
        {name:'도면',items:['도면등록','도면개정등록','도면개정현황']},
        {name:'문서',items:['문서관리대장','문서 제·개정등록','문서 유효현황']}
      ],
