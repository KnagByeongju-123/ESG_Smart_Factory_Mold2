# ─────────────────────────────────────────────────────────────
#  MES 파이썬 도구 접속정보
#  이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채우세요:   copy .env.example .env
#  .env 는 GitHub 에 올라가지 않습니다(.gitignore). 비밀번호·secret 키는 .env 에만 넣으세요.
# ─────────────────────────────────────────────────────────────

# 사용할 DB 목록 (쉼표로 구분). 나중에 흩어진 다른 사이트를 모을 때 site2,site3 처럼 추가
MES_PROFILES=legacy,company

# ── 기존 DB (지금 쓰는 Supabase) ─────────────────────────────
LEGACY_LABEL=기존
LEGACY_URL=https://jgvikmakenpllwxwdugk.supabase.co
LEGACY_PUBLISHABLE_KEY=sb_publishable_sKp-6nz2PQ9LxQ5pF-nYkg_YwoEJN6S
#   Supabase › Project Settings › API Keys › Secret keys (sb_secret_…)  — 파일(사진·도면) 복사, 전체 읽기에 필요
LEGACY_SECRET_KEY=
#   Supabase › 상단 [Connect] › Session pooler 의 연결 문자열 ([YOUR-PASSWORD] 를 DB 비밀번호로 바꿈)
#   예) postgresql://postgres.jgvikmakenpllwxwdugk:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#   구조 복사·데이터 복사·오라클 내보내기에 필요
LEGACY_DB_URL=

# ── 회사 DB (회사용으로 새로 만든 Supabase) ──────────────────
COMPANY_LABEL=회사
COMPANY_URL=
COMPANY_PUBLISHABLE_KEY=
COMPANY_SECRET_KEY=
COMPANY_DB_URL=

# ── (나중에) 다른 사이트 — MES_PROFILES 에 이름을 추가하고 아래처럼 채움 ──
# SITE2_LABEL=2공장
# SITE2_URL=
# SITE2_PUBLISHABLE_KEY=
# SITE2_SECRET_KEY=
# SITE2_DB_URL=

# ── 회사 오라클 DB (ERP 등) ───────────────────────────────────
#   DSN 형식: 호스트:포트/서비스명   예) 192.168.0.10:1521/ORCLPDB1
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
#   (선택) 오라클 19c 이하에서 thin 모드가 안 되면 Instant Client 폴더를 지정 → thick 모드
ORACLE_CLIENT_DIR=
